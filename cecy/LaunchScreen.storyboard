        <namedColor name="AccentColor"><color red="0.15" green="0.35" blue="0.29" alpha="1" colorSpace="custom" customColorSpace="sRGB"/></namedColor>
        <namedColor name="LaunchBackground"><color red="0.965" green="0.965" blue="0.945" alpha="1" colorSpace="custom" customColorSpace="sRGB"/></namedColor>
